@page "/customer-create"
@using Frontend.Blazor.Models
@using Frontend.Blazor.Services
@inject CustomerApiService CustomerService
@inject NavigationManager NavigationManager

<PageTitle>Nuevo Cliente</PageTitle>

<h3>Registrar Nuevo Cliente</h3>

<div class="row">
    <div class="col-md-6">
        <EditForm Model="@customer" OnValidSubmit="HandleSubmit">

            <div class="mb-3">
                <label class="form-label">Nombre Completo</label>
                <InputText @bind-Value="customer.Name" class="form-control" />
            </div>

            <div class="mb-3">
                <label class="form-label">Correo Electrónico</label>
                <InputText @bind-Value="customer.Email" class="form-control" type="email" />
            </div>

            <div class="mb-3">
                <label class="form-label">Calle y Número</label>
                <InputText @bind-Value="customer.Street" class="form-control" />
            </div>

            <div class="mb-3">
                <label class="form-label">Ciudad</label>
                <InputText @bind-Value="customer.City" class="form-control" />
            </div>

            <div class="mb-3">
                <label class="form-label">País</label>
                <InputText @bind-Value="customer.Country" class="form-control" />
            </div>

            <button type="submit" class="btn btn-success">Guardar</button>
            <button type="button" class="btn btn-secondary" @onclick="GoBack">Cancelar</button>

        </EditForm>
    </div>
</div>

@code {
    // Instanciamos el DTO vacío para que el formulario lo llene
    private CustomerCreateDto customer = new();

    private async Task HandleSubmit()
    {
        // Enviamos el DTO al microservicio
        await CustomerService.CreateCustomerAsync(customer);

        // Volvemos a la lista
        NavigationManager.NavigateTo("/customers");
    }

    private void GoBack()
    {
        NavigationManager.NavigateTo("/customers");
    }
}