@page "/"

<PageTitle>Inicio - Sistema de Gestión</PageTitle>

<div class="container text-center mt-4">
    <h1 class="display-4 text-primary fw-bold">Sistema de Gestión Central</h1>
    <p class="lead mt-3">Plataforma basada en Arquitectura de Microservicios y Blazor WebAssembly.</p>
    <hr class="my-4" />

    <div class="row mt-5">
        <!-- Tarjeta Clientes -->
        <div class="col-md-4 mb-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body">
                    <h1 class="display-4 text-info mt-2">👥</h1>
                    <h3 class="card-title mt-3">Clientes</h3>
                    <p class="card-text text-muted">Gestiona la base de datos de clientes registrados en el sistema.</p>
                    <a href="/customers" class="btn btn-outline-info w-100">Ir a Clientes</a>
                </div>
            </div>
        </div>

        <!-- Tarjeta Productos -->
        <div class="col-md-4 mb-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body">
                    <h1 class="display-4 text-success mt-2">📦</h1>
                    <h3 class="card-title mt-3">Productos</h3>
                    <p class="card-text text-muted">Administra el catálogo, los precios y el stock disponible.</p>
                    <a href="/products" class="btn btn-outline-success w-100">Ir a Productos</a>
                </div>
            </div>
        </div>

        <!-- Tarjeta Órdenes -->
        <div class="col-md-4 mb-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body">
                    <h1 class="display-4 text-warning mt-2">🛒</h1>
                    <h3 class="card-title mt-3">Órdenes</h3>
                    <p class="card-text text-muted">Genera nuevas ventas y consulta el historial completo.</p>
                    <a href="/order-create" class="btn btn-outline-warning w-100">Nueva Orden</a>
                </div>
            </div>
        </div>
    </div>
</div>